# Directorios de trabajo del asistente (no versionar).
/.claude/
/.agents/
/.impeccable/

# CLAUDE.md SÍ se versiona en este repositorio: es el puntero que lleva a
# PRODUCT.md y DESIGN.md, y dejarlo fuera significaba que en otra máquina no
# existía ninguno de los tres. La negación hace falta porque el .gitignore
# global del usuario (~/.gitignore_global) lo excluye en todos sus
# repositorios; el .gitignore del proyecto tiene prioridad sobre el global,
# así que este ajuste no altera esa configuración personal.
!CLAUDE.md

*.log
.DS_Store
.env
# Cualquier variante de .env, salvo el ejemplo. Sin esto, un «cp .env
# .env.bak» antes de un «git add -A» publicaría las credenciales de la base
# de datos en un repositorio abierto.
.env.*
!.env.example
*.sql
*.sql.gz
*.dump
*.bak
*.orig
*~
.phpactor.json
.phpunit.result.cache
/.codex
/.cursor/
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/auth.json
/node_modules
/public/build
/public/fonts-manifest.dev.json
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
_ide_helper.php
Homestead.json
Homestead.yaml
Thumbs.db
