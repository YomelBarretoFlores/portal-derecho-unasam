APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

TRUSTED_PROXIES=

# --- Archivos subidos desde el panel (portadas, logo, PDF, retratos) ---
# MEDIA_DISK elige la infraestructura. Los dos modos funcionan sin tocar código:
#   public  → disco del servidor (storage/app/public). Necesita volumen persistente.
#   medios  → proveedor compatible con S3. Necesita las AWS_* del final del fichero.
MEDIA_DISK=public
# Interruptor maestro. Ponlo en true SOLO cuando el almacenamiento sobreviva a un
# despliegue: sobre un disco efímero se suben archivos y se pierden sin aviso.
# Compruébalo antes con «php artisan almacenamiento:verificar».
MEDIA_UPLOADS_ENABLED=true
MEDIA_MAX_IMAGE_KB=5120
MEDIA_MAX_PDF_KB=20480

# Los envíos públicos requieren privacidad aprobada y almacenamiento privado persistente.
# SUBMISSIONS_DISK: «local» (storage/app/private) o «manuscritos» (bucket privado).
# Nunca apunte a un disco público: son originales inéditos con datos personales.
SUBMISSIONS_ENABLED=false
SUBMISSIONS_DISK=local
SUBMISSIONS_PRIVACY_APPROVED=false
SUBMISSIONS_STORAGE_PERSISTENT=false
SUBMISSIONS_MANUSCRIPT_MAX_KB=15360
SUBMISSIONS_ATTACHMENT_MAX_KB=10240
SUBMISSIONS_PERSONAL_EMAIL_DOMAINS=gmail.com,hotmail.com,outlook.com,yahoo.com,icloud.com,live.com

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de datos: PostgreSQL (Neon). Usar el endpoint -pooler.
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require
DB_PERSISTENT=false
PGCONNECT_TIMEOUT=10

# Credenciales opcionales para el seeder inicial. No hay valores predeterminados.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Sesión/caché/colas en almacenamiento LOCAL (no en la BD remota).
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false

FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Proveedor compatible con S3 (solo si MEDIA_DISK=medios) ---
# Vale Cloudflare R2, el almacenamiento de objetos de Neon, MinIO, AWS S3 o un
# servidor propio. Lo único que cambia entre ellos es AWS_ENDPOINT.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# Endpoint de la API. Vacío en AWS S3; obligatorio en el resto.
AWS_ENDPOINT=
# URL pública de lectura del bucket (p. ej. https://medios.derecho.unasam.edu.pe).
# Sin esto las imágenes se guardan bien pero el navegador las bloquea por CSP.
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Bucket PRIVADO de manuscritos (solo si SUBMISSIONS_DISK=manuscritos).
# Debe ser un bucket distinto del de medios y sin lectura pública.
# Las credenciales caen a las AWS_* de arriba si se dejan vacías.
AWS_SUBMISSIONS_BUCKET=
AWS_SUBMISSIONS_ACCESS_KEY_ID=
AWS_SUBMISSIONS_SECRET_ACCESS_KEY=
AWS_SUBMISSIONS_DEFAULT_REGION=
AWS_SUBMISSIONS_ENDPOINT=

