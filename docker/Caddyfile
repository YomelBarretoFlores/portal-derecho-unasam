{
	# Render termina el TLS por nosotros; servimos HTTP plano en $PORT.
	auto_https off
	admin off
}

# Escucha en el puerto que provee Render (con 8080 como valor por defecto)
:{$PORT:8080} {
	root * /app/public
	encode zstd gzip

	# Sirve archivos estáticos y enruta todo lo demás al front controller de Laravel
	php_server {
		index index.php
	}
}
